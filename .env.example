# ==============================================================================
# SaaS Motion Pro & Portfolio Environment Configuration Example
# ==============================================================================
# Configure these variables in your Vercel Project Settings (Settings -> Environment Variables).
# After adding or updating variables in Vercel, trigger a new deployment for changes to take effect.

# ------------------------------------------------------------------------------
# 1. Resend Email Delivery & Admin Alerts
# ------------------------------------------------------------------------------
# Secret API Key from your Resend dashboard (https://resend.com/api-keys).
# Must start with "re_" and remain secret. NEVER expose in client bundles.
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender address on sabbirhossen.site domain with verified DKIM & SPF records.
# Matches: SaaS Motion Pro <licenses@sabbirhossen.site>
EMAIL_FROM="SaaS Motion Pro <licenses@sabbirhossen.site>"

# Administrator notification email for new manual payment reviews and critical system alerts.
ADMIN_EMAIL=myselfsabbirhossen@gmail.com

# (Optional) Resend Webhook Secret for real-time delivery and bounce tracking.
# Found in Resend Webhook settings (e.g. whsec_...).
# RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# (Optional) Fallback email webhook relay URL (used only if RESEND_API_KEY is not set).
# EMAIL_WEBHOOK_URL=https://relay.yourdomain.com/send-email

# ------------------------------------------------------------------------------
# 2. Database (Turso / LibSQL)
# ------------------------------------------------------------------------------
# Primary database connection. If unset, automatically falls back to local data/saas_motion_pro.db
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# ------------------------------------------------------------------------------
# 3. Super Admin & Licensing Security
# ------------------------------------------------------------------------------
# Secret administrative API key for authenticated server-to-server operations.
ADMIN_SECRET_KEY=your_secure_admin_secret_key_here

# Ed25519 Private Signing Key (PEM format or base64) for asymmetric cryptographic tokens.
# Required on server to sign license tokens for After Effects workstation activation.
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 4. Storage & Media (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=sabbir-portfolio
R2_PUBLIC_BASE_URL="https://media.sabbirhossen.site"
